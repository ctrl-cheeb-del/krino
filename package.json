{
  "name": "krino",
  "version": "0.2.0",
  "description": "R2/S3-backed filesystem for just-bash. Agents get a real-feeling bash; files live in object storage; nothing runs between commands.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "bench": "bun bench/run.ts"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "just-bash": "^3.6.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "just-bash": "^3.6.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "keywords": [
    "just-bash",
    "bash",
    "agent",
    "ai",
    "filesystem",
    "r2",
    "s3",
    "cloudflare",
    "workers",
    "llm",
    "sandbox"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  }
}
